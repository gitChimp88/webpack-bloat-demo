{
  "name": "webpack-bloat-demo",
  "version": "1.0.0",
  "description": "Deliberately bloated webpack bundle for optimization tutorial",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:prod": "webpack --config webpack.config.js --mode production",
    "build:analyze": "webpack --config webpack.config.js --env analyze",
    "start": "npm run build && serve dist"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-chartjs-2": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.0",
    "serve": "^14.2.0"
  }
}
